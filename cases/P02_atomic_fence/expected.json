        {"kind": "Load", "object": "x", "ordering": "relaxed"}
      ]
    }
  ],
  "outcome": [
    {"thread": 0, "object": "y", "occurrence": 0, "value": 0},
    {"thread": 1, "object": "x", "occurrence": 0, "value": 0}
